{
	"bindings": {
		"/actions/game": {
			"sources": [
				{
					"mode": "button",
					"path": "/user/hand/left/input/trigger",
					"inputs": {
						"click": {
							"output": "/actions/game/in/fire"
						}
					}
				},
				{
					"mode": "grab",
					"path": "/user/hand/left/input/grip",
					"inputs": {
						"grab": {
							"output": "/actions/game/in/grab"
						}
					},
					"parameters": {
						"haptic_amplitude": "0.3"
					}
				},
				{
					"mode": "button",
					"path": "/user/hand/right/input/trigger",
					"inputs": {
						"click": {
							"output": "/actions/game/in/delayed"
						}
					},
					"parameters": {
						"haptic_delay": "0.05"
					}
				}
			]
		},
		"/actions/menu": {
			"sources": [
				{
					"mode": "button",
					"path": "/user/hand/left/input/trigger",
					"inputs": {
						"click": {
							"output": "/actions/menu/in/select"
						}
					},
					"parameters": {
						"haptic_amplitude": "0"
					}
				},
				{
					"mode": "button",
					"path": "/user/hand/right/input/grip",
					"inputs": {
						"click": {
							"output": "/actions/menu/in/drag"
						}
					}
				}
			]
		}
	}
}

{
	"bindings": {
		"/actions/main": {
			"haptics": [
				{
					"output": "/actions/main/in/vib",
					"path": "/user/gamepad/output/haptic"
				},
				{
					"output": "/actions/main/in/vib",
					"path": "/user/hand/left/output/haptic"
				}
			],
			"sources": [
				{
					"inputs": {
						"click": {
							"output": "/actions/main/in/fire"
						}
					},
					"mode": "button",
					"path": "/user/gamepad/input/trigger_right"
				},
				{
					"inputs": {
						"click": {
							"output": "/actions/main/in/jump"
						}
					},
					"mode": "button",
					"path": "/user/gamepad/input/a"
				},
				{
					"inputs": {
						"click": {
							"output": "/actions/main/in/jump"
						}
					},
					"mode": "button",
					"path": "/user/hand/left/input/x"
				},
				{
					"inputs": {
						"pull": {
							"output": "/actions/main/in/throttle"
						}
					},
					"mode": "trigger",
					"path": "/user/gamepad/input/trigger_left"
				},
				{
					"inputs": {
						"position": {
							"output": "/actions/main/in/move"
						}
					},
					"mode": "joystick",
					"path": "/user/gamepad/input/joystick_left"
				},
				{
					"inputs": {
						"east": {
							"output": "/actions/main/in/turn"
						}
					},
					"mode": "dpad",
					"parameters": {
						"deadzone_pct": "90",
						"overlap_pct": "0",
						"sub_mode": "touch"
					},
					"path": "/user/gamepad/input/joystick_right"
				}
			]
		},
		"/actions/menu": {
			"sources": [
				{
					"inputs": {
						"click": {
							"output": "/actions/menu/in/select"
						}
					},
					"mode": "button",
					"path": "/user/gamepad/input/trigger_right"
				}
			]
		}
	},
	"controller_type": "gamepad"
}

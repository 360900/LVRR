{
	"controller_type": "oculus_touch",
	"bindings": {
		"/actions/move": {
			"sources": [
				{
					"inputs": {
						"east": { "output": "/actions/move/in/teleport" },
						"north": { "output": "/actions/move/in/teleport" },
						"south": { "output": "/actions/move/in/teleport" },
						"west": { "output": "/actions/move/in/teleport" }
					},
					"mode": "dpad",
					"parameters": {
						"deadzone_pct": "55",
						"overlap_pct": "30",
						"sticky": "true",
						"sub_mode": "touch"
					},
					"path": "/user/hand/left/input/joystick"
				},
				{
					"inputs": {
						"click": { "output": "/actions/move/in/adjustheight" },
						"position": { "output": "/actions/move/in/teleportturn" }
					},
					"mode": "joystick",
					"parameters": {
						"deadzone_pct": "5",
						"maxzone_pct": "90"
					},
					"path": "/user/hand/left/input/joystick"
				},
				{
					"inputs": {
						"click": { "output": "/actions/move/in/walk" }
					},
					"mode": "button",
					"parameters": {
						"force_input": "position",
						"haptic_amplitude": "0"
					},
					"path": "/user/hand/left/input/joystick"
				},
				{
					"inputs": {
						"east": { "output": "/actions/move/in/turnright" },
						"north": { "output": "/actions/move/in/walkmantle" },
						"south": { "output": "/actions/move/in/shiftdashjump" },
						"west": { "output": "/actions/move/in/turnleft" }
					},
					"mode": "dpad",
					"parameters": {
						"deadzone_pct": "75",
						"overlap_pct": "0",
						"sticky": "true",
						"sub_mode": "touch"
					},
					"path": "/user/hand/right/input/joystick"
				},
				{
					"inputs": {
						"south": { "output": "/actions/move/in/moveback" }
					},
					"mode": "dpad",
					"parameters": {
						"deadzone_pct": "75",
						"overlap_pct": "0",
						"sticky": "true",
						"sub_mode": "touch"
					},
					"path": "/user/hand/right/input/joystick"
				},
				{
					"inputs": {
						"position": { "output": "/actions/move/in/continuousturn" }
					},
					"mode": "joystick",
					"parameters": {
						"deadzone_pct": "75",
						"sticky_click": "true"
					},
					"path": "/user/hand/right/input/joystick"
				}
			]
		},
		"/actions/scroll": {
			"sources": [
				{
					"inputs": {
						"position": { "output": "/actions/scroll/in/scroll" }
					},
					"mode": "joystick",
					"path": "/user/hand/left/input/joystick"
				},
				{
					"inputs": {
						"position": { "output": "/actions/scroll/in/scroll" }
					},
					"mode": "joystick",
					"path": "/user/hand/right/input/joystick"
				}
			]
		},
		"/actions/weapon": {
			"sources": [
				{
					"inputs": {
						"click": { "output": "/actions/weapon/in/showinventory" }
					},
					"mode": "joystick",
					"path": "/user/hand/right/input/joystick"
				}
			]
		}
	}
}

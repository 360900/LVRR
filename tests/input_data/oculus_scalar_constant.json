{
	"bindings": {
		"/actions/main": {
			"sources": [
				{
					"mode": "scalar_constant",
					"path": "/user/hand/right/input/a",
					"inputs": {
						"value": {
							"output": "/actions/main/in/alternateuse"
						}
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/left/input/trigger",
					"inputs": {
						"value": {
							"output": "/actions/main/in/repel"
						}
					},
					"parameters": {
						"on/x": "1.0"
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/left/input/x",
					"inputs": {
						"value": {
							"output": "/actions/main/in/reverse"
						}
					},
					"parameters": {
						"on/x": "-1"
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/left/input/y",
					"inputs": {
						"value": {
							"output": "/actions/main/in/offset"
						}
					},
					"parameters": {
						"on/x": "0.5",
						"off/x": "0.25"
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/right/input/b",
					"inputs": {
						"value": {
							"output": "/actions/main/in/throttle"
						}
					},
					"parameters": {
						"on/x": -0.5
					}
				},
				{
					"mode": "trigger",
					"path": "/user/hand/right/input/trigger",
					"inputs": {
						"pull": {
							"output": "/actions/main/in/throttle"
						}
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/left/input/grip",
					"inputs": {
						"value": {
							"output": "/actions/main/in/steer"
						}
					},
					"parameters": {
						"on/x": "-1"
					}
				},
				{
					"mode": "joystick",
					"path": "/user/hand/left/input/joystick",
					"inputs": {
						"position": {
							"output": "/actions/main/in/steer"
						}
					}
				},
				{
					"mode": "scalar_constant",
					"path": "/user/hand/right/input/grip",
					"inputs": {
						"value": {
							"output": "/actions/main/in/look"
						}
					},
					"parameters": {
						"on/x": "0.5",
						"on/y": "-0.5",
						"on/z": "1",
						"off/z": "-1"
					}
				}
			]
		},
		"/actions/menu": {
			"sources": [
				{
					"mode": "button",
					"path": "/user/hand/right/input/grip",
					"inputs": {
						"click": {
							"output": "/actions/menu/in/select"
						}
					}
				}
			]
		}
	}
}

# wayvr's entry, kept out of menus (NoDisplay; Hidden would mean deleted).
# KWin before 6.8 offers zkde_screencast_unstable_v1 only to a client whose
# entry lists it, found by matching the absolute Exec to its executable.
[Desktop Entry]
Name=LVRR VR desktop
Exec=@WAYVR@
Icon=@PREFIX@/share/icons/hicolor/scalable/apps/io.github.lvrr.svg
Type=Application
NoDisplay=true
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1

pkgname=lvrr-git
pkgver=r0
pkgrel=1
pkgdesc="Linux VR Runtime: VR streaming to standalone headsets, OpenVR games without SteamVR and desktop in VR"
arch=(x86_64)
url="https://github.com/360900/LVRR"
license=(GPL-3.0-or-later)
depends=(
  # WiVRn server
  avahi boost-libs cairo ffmpeg glib2 glibc libarchive libbsd libgcc libgl libnotify libpipewire libpng
  librsvg libstdc++ libx11 libxcb openssl systemd-libs vulkan-icd-loader x264
  # lvrr: icon, and pkexec for `lvrr doctor --fix`
  hicolor-icon-theme polkit
  # wayvr, and the LVRR window
  alsa-lib dav1d dbus libinput libxcursor libxext libxi libxkbcommon libxkbcommon-x11 libxrandr openvr
  openxr wayland xwayland-satellite
  # 32-bit xrizer
  lib32-gcc-libs lib32-glibc
)
makedepends=(
  boost clang cli11 cmake eigen git glib2-devel libdrm ninja nlohmann-json python rustup shaderc
  vulkan-headers
)
optdepends=(
  'android-tools: lvrr usb and lvrr install'
  'wl-clipboard: copying from the LVRR window on Wayland'
)
provides=(lvrr)
conflicts=(lvrr)
# LTO objects in the static OpenXR loader break the Rust link.
options=(!lto !debug)
source=("lvrr::git+https://github.com/360900/LVRR.git")
sha256sums=(SKIP)

pkgver() {
  cd lvrr
  if git describe --tags --match 'v[0-9]*' >/dev/null 2>&1; then
    git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd lvrr
  cargo xtask build --release --i686 --prefix /opt/lvrr
}

package() {
  cd lvrr
  cargo xtask install --destdir "$pkgdir"
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  ln -s /opt/lvrr/bin/lvrr "$pkgdir/usr/bin/lvrr"
  ln -s /opt/lvrr/share/applications/io.github.lvrr.desktop "$pkgdir/usr/share/applications/io.github.lvrr.desktop"
}

+// Copyright 2026, 360900
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  OpenGL client swapchain for apps on another GPU than the runtime.
+ * @ingroup comp_client
+ */
+
+#pragma once
+
+#include "xrt/xrt_defines.h"
+#include "xrt/xrt_compositor.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct client_gl_swapchain;
+
+/*!
+ * The Vulkan device on the runtime's GPU that uploads the frames of a
+ * @ref client_gl_hostcopy_swapchain, one per @ref client_gl_compositor.
+ *
+ * An OpenGL app whose context is on another GPU than the runtime, such as the
+ * integrated GPU of a hybrid laptop, can't import the runtime's images: Mesa
+ * crashes when a memory object of another device is imported. The app draws
+ * into plain textures instead, which are read back into host memory when
+ * released and copied into the native images by this device.
+ */
+struct client_gl_hostcopy;
+
+/*!
+ * Whether the current OpenGL context's device is another one than the
+ * runtime's. Needs GL_EXT_memory_object for the device UUIDs, without it
+ * returns false and the usual import is tried.
+ *
+ * The app's context must be current.
+ */
+bool
+client_gl_hostcopy_needed(const xrt_uuid_t *runtime_device_uuid);
+
+/*!
+ * Creates a Vulkan device on the runtime's GPU, NULL if there is none.
+ */
+struct client_gl_hostcopy *
+client_gl_hostcopy_create(const xrt_uuid_t *runtime_device_uuid);
+
+void
+client_gl_hostcopy_destroy(struct client_gl_hostcopy **hc_ptr);
+
+/*!
+ * Create a swapchain, belonging to a client_gl_compositor with a
+ * @ref client_gl_hostcopy, whose frames go through host memory.
+ *
+ * The caller must ensure that the app context is current.
+ *
+ * @see client_gl_swapchain_create_func_t, client_gl_compositor_init
+ */
+struct xrt_swapchain *
+client_gl_hostcopy_swapchain_create(struct xrt_compositor *xc,
+                                    const struct xrt_swapchain_create_info *info,
+                                    struct xrt_swapchain_native *xscn,
+                                    struct client_gl_swapchain **out_cglsc);
+
+
+#ifdef __cplusplus
+}
+#endif

 	return &client_gl_compositor(xc)->xcn->base;
 }
 
-static int64_t
-gl_format_to_vk(int64_t format)
+int64_t
+client_gl_format_to_vk(int64_t format)
 {
 	switch (format) {
 	case GL_RGB8: return 23 /*VK_FORMAT_R8G8B8_UNORM*/; // Should not be used, colour precision.
@@ -422,7 +423,7 @@ client_gl_compositor_get_swapchain_create_properties(struct xrt_compositor *xc,
 {
 	struct client_gl_compositor *c = client_gl_compositor(xc);
 
-	int64_t vk_format = gl_format_to_vk(info->format);
+	int64_t vk_format = client_gl_format_to_vk(info->format);
 	if (vk_format == 0) {
 		U_LOG_E("Invalid format!");
 		return XRT_ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED;
@@ -451,7 +452,7 @@ client_gl_swapchain_create(struct xrt_compositor *xc,
 	}
 
 	// Check before setting the context.
-	int64_t vk_format = gl_format_to_vk(info->format);
+	int64_t vk_format = client_gl_format_to_vk(info->format);
 	if (vk_format == 0) {
 		U_LOG_E("Invalid format!");
 		return XRT_ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED;
@@ -479,6 +480,12 @@ client_gl_swapchain_create(struct xrt_compositor *xc,
 	vkinfo.format = vk_format;
 	vkinfo.bits |= xsccp.extra_bits;
 
+	if (c->hostcopy != NULL) {
+		// The frames are copied into the native images.
+		xinfo.bits |= XRT_SWAPCHAIN_USAGE_TRANSFER_DST;
+		vkinfo.bits |= XRT_SWAPCHAIN_USAGE_TRANSFER_DST;
+	}
+
 	struct xrt_swapchain_native *xscn = NULL; // Has to be NULL.
 	xret = xrt_comp_native_create_swapchain(c->xcn, &vkinfo, &xscn);
 
@@ -580,6 +587,7 @@ client_gl_compositor_destroy(struct xrt_compositor *xc)
 void
 client_gl_compositor_fini(struct client_gl_compositor *c)
 {
+	client_gl_hostcopy_destroy(&c->hostcopy);
 	os_mutex_destroy(&c->context_mutex);
 }
 
@@ -589,7 +597,8 @@ client_gl_compositor_init(struct client_gl_compositor *c,
                           client_gl_context_begin_locked_func_t context_begin_locked,
                           client_gl_context_end_locked_func_t context_end_locked,
                           client_gl_swapchain_create_func_t create_swapchain,
-                          client_gl_insert_fence_func_t insert_fence)
+                          client_gl_insert_fence_func_t insert_fence,
+                          const xrt_uuid_t *runtime_device_uuid)
 {
 	assert(context_begin_locked != NULL);
 	assert(context_end_locked != NULL);
@@ -646,5 +655,24 @@ client_gl_compositor_init(struct client_gl_compositor *c,
 
 	os_mutex_init(&c->context_mutex);
 
+	// An app on another GPU than the runtime can't import its images.
+	c->hostcopy = NULL;
+	if (runtime_device_uuid != NULL &&
+	    client_gl_compositor_context_begin(&c->base, CLIENT_GL_CONTEXT_REASON_OTHER) == XRT_SUCCESS) {
+		bool needed = client_gl_hostcopy_needed(runtime_device_uuid);
+		client_gl_compositor_context_end(&c->base, CLIENT_GL_CONTEXT_REASON_OTHER);
+
+		if (needed) {
+			c->hostcopy = client_gl_hostcopy_create(runtime_device_uuid);
+			if (c->hostcopy == NULL) {
+				U_LOG_E(
+				    "The OpenGL context is on another GPU than the runtime and frames can't be copied");
+				os_mutex_destroy(&c->context_mutex);
+				return false;
+			}
+			c->create_swapchain = client_gl_hostcopy_swapchain_create;
+		}
+	}
+
 	return true;
 }

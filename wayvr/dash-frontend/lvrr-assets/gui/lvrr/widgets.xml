<layout version="2">
  <!-- LVRR: building blocks for the LVRR dashboard pages, see src/tab/lvrr/ui.rs -->
  <include src="@/gui/t_group_box.xml" />
  <include src="@/gui/t_dropdown_button.xml" />

  <!-- id, translation, icon -->
  <template name="Group">
    <rectangle macro="group_box" id="${id}" width="100%">
      <GroupBoxTitle translation="${translation}" src_builtin="${icon}" />
    </rectangle>
  </template>

  <!-- id -->
  <template name="Row">
    <div id="${id}" flex_direction="row" align_items="center" gap="12" flex_wrap="wrap" />
  </template>

  <!-- id; a row that wraps its children within the parent's width -->
  <template name="WrapRow">
    <div id="${id}" flex_direction="row" align_items="center" gap="12" flex_wrap="wrap" width="100%" />
  </template>

  <!-- translation; a section heading with an underline rule -->
  <template name="SectionHeader">
    <div flex_direction="column" gap="6" width="100%" margin_top="12">
      <label translation="${translation}" weight="bold" size="16" color="on_background" />
      <rectangle width="100%" height="2" color="outline" />
    </div>
  </template>

  <!-- id; a row that never wraps, for a Column of details followed by buttons -->
  <template name="Line">
    <div id="${id}" flex_direction="row" align_items="center" gap="12" width="100%" />
  </template>

  <!-- id; takes the rest of a Row's line and puts its children at its end. A Line there
       would be as wide as the Row and wrap onto a line of its own. -->
  <template name="RowEnd">
    <div id="${id}" flex_direction="row" align_items="center" justify_content="end" gap="4" flex_grow="1" />
  </template>

  <!-- id -->
  <template name="Column">
    <div id="${id}" flex_direction="column" gap="4" flex_grow="1" flex_shrink="1" />
  </template>

  <!-- id; a column as wide as its parent, so section rules and rows span the group.
       A Group doesn't stretch its children, and a Column is only as wide as its widest row. -->
  <template name="List">
    <div id="${id}" flex_direction="column" gap="4" width="100%" />
  </template>

  <!-- id; a positioning context sized to its child, for overlays on a game cover -->
  <template name="CoverWrap">
    <div id="${id}" position="relative" flex_direction="column" />
  </template>

  <!-- id; pinned to the top-right corner of a CoverWrap. CoverWrap is a column, so
       align_self moves along the horizontal axis; justify_self does nothing in flexbox. -->
  <template name="CornerOverlay">
    <div id="${id}" position="absolute" align_self="end" margin_top="6" margin_right="6" flex_direction="row" align_items="center" gap="4" />
  </template>

  <!-- text, translation, size, color -->
  <template name="Text">
    <label text="${text}" translation="${translation}" size="${size}" color="${color}" wrap="1" />
  </template>

  <!-- text, translation, size, color -->
  <template name="Bold">
    <label text="${text}" translation="${translation}" size="${size}" color="${color}" weight="bold" wrap="1" />
  </template>

  <!-- translation, color; body text size, smaller is hard to read on the VR panel -->
  <template name="Badge">
    <rectangle round="4" color="${color}(opacity-0.25)" border="1" border_color="${color}" padding_left="6" padding_right="6" padding_top="2" padding_bottom="2">
      <label translation="${translation}" size="14" weight="bold" color="${color}" />
    </rectangle>
  </template>

  <!-- translation, icon, color; a Badge with an icon before the text, for game covers.
       Its fill is opaque like IconButton's, a see-through one is hard to read on bright art. -->
  <template name="IconBadge">
    <rectangle round="4" color="background_contrast" border="1" border_color="${color}" padding_left="6" padding_right="6" padding_top="2" padding_bottom="2" flex_direction="row" align_items="center" gap="4">
      <sprite src_builtin="${icon}" width="14" height="14" color="${color}" />
      <label translation="${translation}" size="14" weight="bold" color="${color}" />
    </rectangle>
  </template>

  <!-- id, text, translation, checked -->
  <template name="ToggleText">
    <CheckBox id="${id}" text="${text}" translation="${translation}" checked="${checked}" />
  </template>

  <!-- id, min, max, step, value; the label goes above it, see Ui::slider -->
  <template name="Slider">
    <Slider id="${id}" width="300" height="24" min_value="${min}" max_value="${max}" step="${step}" value="${value}" />
  </template>

  <!-- id, text; in VR the keyboard types into it while it has focus -->
  <template name="EditBox">
    <EditBox id="${id}" text="${text}" width="260" height="32" />
  </template>

  <!-- id, text, translation, icon, color; a Button clips what overflows it, which lets flexbox
       shrink it below its content beside a long text in a Line, the sprite first as it has no
       content size. The text beside it wraps instead. -->
  <template name="Button">
    <Button id="${id}" height="32" padding="4" gap="8" color="${color}" flex_shrink="0">
      <sprite src_builtin="${icon}" height="24" width="24" flex_shrink="0" />
      <label text="${text}" translation="${translation}" weight="bold" />
    </Button>
  </template>

  <!-- id, icon, tooltip; doesn't shrink beside a long text either, see Button -->
  <template name="IconButton">
    <Button id="${id}" width="32" height="32" padding="4" color="background_contrast" tooltip="${tooltip}" align_items="center" justify_content="center" flex_shrink="0">
      <sprite src_builtin="${icon}" height="24" width="24" />
    </Button>
  </template>

  <!-- id, translation, icon; the label always gets room for two lines, so icons line up across tiles.
       A sprite has no content size, so without flex_shrink="0" flexbox would squash it first. -->
  <template name="ActionButton">
    <Button id="${id}" width="150" height="104" padding="8" gap="8" flex_direction="column" align_items="center" justify_content="center">
      <sprite src_builtin="${icon}" height="40" width="40" flex_shrink="0" />
      <div height="40" flex_shrink="0" flex_direction="column" justify_content="center" align_items="center">
        <label translation="${translation}" weight="bold" align="center" wrap="1" />
      </div>
    </Button>
  </template>

  <!-- translation, value_id -->
  <template name="Stat">
    <rectangle flex_direction="column" align_items="center" gap="4" min_width="120" padding="8" round="8" color="background_contrast(opacity-0.5)" border="2" border_color="outline">
      <label translation="${translation}" size="12" color="secondary" />
      <label id="${value_id}" weight="bold" size="18" text="-" />
    </rectangle>
  </template>

  <!-- id, name, limit_max, unit -->
  <template name="Graph">
    <rectangle flex_direction="column" align_items="center" gap="8" border="2" color="#ffffff11" color2="#ffffff22" gradient="vertical" border_color="#ffffff33" round="4" padding="4">
      <label translation="${name}" size="12" weight="bold" />
      <BarGraph id="${id}" width="240" height="80" unit="${unit}" limit_min="0" limit_max="${limit_max}" capacity="120" />
    </rectangle>
  </template>

  <!-- id, translation, color -->
  <template name="Banner">
    <rectangle id="${id}" width="100%" flex_direction="row" align_items="center" justify_content="space_between" gap="12" padding="12" round="8" color="${color}(opacity-0.2)" border="2" border_color="${color}">
      <label translation="${translation}" weight="bold" wrap="1" />
    </rectangle>
  </template>
</layout>

<layout version="2">
  <!-- LVRR: PC side of LVRR, see src/tab/lvrr/pc.rs -->
  <macro name="tab_style" color="background" />
  <elements>
    <div gap="4" width="100%">
      <Tabs id="tabs">
        <Tab macro="tab_style" name="performance" translation="LVRR.PC.PERFORMANCE" sprite_src_builtin="@/dashboard/barchart.svg" />
        <Tab macro="tab_style" name="headsets" translation="LVRR.PC.PAIRING" sprite_src_builtin="@/dashboard/wivrn_head_symbolic.svg" />
        <Tab macro="tab_style" name="server" translation="LVRR.PC.SERVER" sprite_src_builtin="@/dashboard/cpu.svg" />
        <Tab macro="tab_style" name="diagnostics" translation="LVRR.PC.DIAGNOSTICS" sprite_src_builtin="@/dashboard/diagnostics.svg" />
        <Tab macro="tab_style" name="about" translation="LVRR.PC.ABOUT" sprite_src_builtin="@/dashboard/info.svg" />
      </Tabs>
      <div id="content" flex_direction="column" gap="8" flex_grow="1">
        <!-- filled in at runtime -->
      </div>
    </div>
  </elements>
</layout>
